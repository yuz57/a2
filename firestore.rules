rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRoomMember(roomId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    function isMessageCreateValid() {
      return request.resource.data.keys().hasAll(['text', 'authorId', 'authorName', 'createdAt']) &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.authorName is string &&
        (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp);
    }

    match /rooms/{roomId} {
      allow read: if isRoomMember(roomId);
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{uid} {
        allow read: if isRoomMember(roomId);
        allow create, update: if signedIn() && uid == request.auth.uid;
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId) && isMessageCreateValid();
        allow update: if false;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }
  }
}
